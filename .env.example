# ========================================
# Firebase の設定値をここに書く
# Firebaseコンソール → プロジェクト設定 → アプリ → SDK設定から取得
# このファイルを .env にコピーして値を入れてください
# ========================================

VITE_FIREBASE_API_KEY=ここにAPIキーを貼る
VITE_FIREBASE_AUTH_DOMAIN=ここに認証ドメインを貼る
VITE_FIREBASE_PROJECT_ID=ここにプロジェクトIDを貼る
VITE_FIREBASE_STORAGE_BUCKET=ここにストレージバケットを貼る
VITE_FIREBASE_MESSAGING_SENDER_ID=ここにメッセージIDを貼る
VITE_FIREBASE_APP_ID=ここにアプリIDを貼る
